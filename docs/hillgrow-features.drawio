                <mxCell id="pzoneg2b26" value="Soil A6 (ADC1_CH3, input-only)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="68" y="574" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2c26" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="408" y="574" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2ft" value="Free GPIO on a zone: 4, 13, 14, 27 (+5 and 0 with care). Expansion headroom lives on the buses: PCA9685 ch 12–15 (future fan PWM) and PCF8575 P8–P15 (8 relay pins) are unused, and more I²C devices can join GPIO21/22." style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=4;fontSize=10;fontColor=#666666;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="4" y="594" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg3" value="Legend" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1144" width="490" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg3r0" value="• Colour = when it lands:  SP1 Foundation (blue) · SP2 Shelf control (green) · SP3 Ring link (orange) · SP4 Web UI (purple) · SP5 Global control (red) · SP6 Display node (teal) · SP7 Media/SD (mauve) · Hardware (yellow) · Grey = out of scope V1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg3" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg3r1" value="• Pin table: free* = strapping pin, usable with care. Source of truth: docs/superpowers/specs/2026-08-31-hillgrow-system-design.md + docs/pin-mapping.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg3" vertex="1">
                    <mxGeometry x="4" y="104" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4" value="Shelf × 1–4 — the reusable growing unit — SP2" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="490" height="366" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r0" value="• Light: photoperiod on/off times + sunrise/sunset ramp · white/red % · per-shelf duty caps (installer) · daily light-hours budget · optional DLI target (turn off early when reached)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r1" value="• Watering: moisture target + hysteresis · dose seconds → settle → response check (no-response latches a fault: dry reservoir/leak/dead pump) · minimum interval · daily budget · watering time window · one pump at a time per zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="88" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r2" value="• Circulation fan: OFF / ON / follow-light / duty-cycle (PWM speed is a future PCA9685 option)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="144" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r3" value="• Soil sensing ×2 (A left, B right): kept separate — never blindly averaged · per-probe dry/wet calibration incl. live capture (SOILCAP) · open/short/out-of-range/stuck detection · A/B disagreement → use the wetter, halve the daily budget" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="184" width="482" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r4" value="• Pollination vibrator per shelf: PWM intensity 20–100 % (PCA9685 ch 8–11) · pulse/interval/day-window schedule · per-shelf daily budget · behind the same OE kill line as the lights" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="256" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r5" value="• Crop = a name + a profile copy; zero crop-specific firmware logic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="312" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg4r6" value="• Per-shelf runtime + fault state, reported in every heartbeat" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg4" vertex="1">
                    <mxGeometry x="4" y="336" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg5" value="Optional zone devices — SP2" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="480" width="490" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg5r0" value="• Spare relays P8–P15 (8): future devices via config; manual overrides always duration-bounded" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg5" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg5r1" value="• PCA9685 ch 12–15 reserved for future fan PWM speed control" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg5" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg6" value="Config &amp; persistence — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="606" width="490" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg6r0" value="• Hardware plane (zone-owned, unlock-gated): shelf count, PCA/PCF channel maps, soil channel maps, calibration, per-shelf safety limits" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg6" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg6r1" value="• Logical plane (master-owned once linked, cached locally): crop/schedules — a zone reboots into full operation with no master" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg6" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg6r2" value="• Daily safety counters survive reboots (RTC memory + NVS 15 min) — a brown-out loop cannot defeat the watering budget" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg6" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg6r3" value="• All blobs versioned (magic+version+CRC); a blob newer than the firmware is rejected, so OTA rollback is always safe" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg6" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7" value="CLI on UART0 — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="828" width="490" height="246" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r0" value="• Complete standalone bring-up and operation: every config field (SET WATER 1 TARGET 60 …), no master needed (sub-project 2 runs a zone solo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r1" value="• Manual actuator commands (duration-bounded) · calibration · GET SOIL/SENSORS/OUTPUTS/FAULTS · CLEAR FAULT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r2" value="• GET CONFIG = replayable dump — export/import a zone by copy-paste" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r3" value="• Same grammar and scripts as via the master (ZONE 0 = this node; wrong id refused)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r4" value="• SET FW UPDATE &lt;ssid&gt; &lt;pass&gt; &lt;url&gt;: bench rescue-pull without a master" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg7r5" value="• Human terminal comfort: echo, backspace, 10-line history, machine mode for test scripts, logs never split replies" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg7" vertex="1">
                    <mxGeometry x="4" y="200" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8" value="Safety manager — SP2" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="90" width="490" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r0" value="• One gate for every output; CLI/web/ring requests all pass the same interlocks — nothing bypasses local safety" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r1" value="• Every ON is a lease: pump max-run (hard cap 300 s) · daily budgets · min-off cooldowns · light duty/day caps · overrides expire" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r2" value="• LOCAL mode: master silent 30 s → plant care continues forever on local schedule + sensors; master inhibit flags age out after 600 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r3" value="• Modes BOOT/TRIAL/HOLD/RUN/LOCAL/SAFE · crash-loop ladder bounds output pulsing, then latches SAFE with CLI alive for diagnosis" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r4" value="• Boot-safe outputs: PCF8575 ← all-off first transaction + 1 s read-back audit · PCA9685 OE released only in RUN/LOCAL · TWDT ISR kills lights in microseconds · shutdown handler on every reboot (accepted residual: ≤0.5 s pump hold on a hard crash)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r5" value="• Sensor-invalid policies decide watering (block / halve budget) · time-unknown fallback schedule (assumed 08:00 boot)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="264" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg8r6" value="• Faults: fixed severity (warn / blocks-scope / SAFE), latched ones need explicit clear, all visible in heartbeat + GET FAULTS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg8" vertex="1">
                    <mxGeometry x="4" y="304" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9" value="Ring node — SP3" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="464" width="490" height="302" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r0" value="• Store-and-forward relay: COBS framing, CRC-16 recomputed per hop, TTL, break-tolerant (unpowered upstream handled)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r1" value="• Heartbeat every 2 s = health + full telemetry + fault masks + comm counters (master sees a fault within 2 s)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r2" value="• Commands arrive as CLI text → same dispatcher, same safety gate · exactly-once execution (retransmits replay the cached reply)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r3" value="• Enrolment: boots unassigned, advertises MAC, accepts ASSIGN_ID; id survives in NVS; board swaps handled by MAC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r4" value="• TIME_SYNC: sets the clock, carries fleet inhibit flags" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r5" value="• Config chunks: reassemble → validate → apply atomically → ACK with the exact error path on refusal; console edits while linked are reverted (master wins)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="216" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg9r6" value="• FW_UPDATE: safe state → handover record → reboot into rescue (pull from master AP)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg9" vertex="1">
                    <mxGeometry x="4" y="256" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg10" value="Rescue &amp; bootloader — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="790" width="490" height="182" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg10r0" value="• Same shared rescue image and bootloader triggers as the master (RTC flag · GPIO15 hold · NVS-erase hold)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg10" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg10r1" value="• Pull mode: joins the master AP, downloads zone.bin, flashes the inactive slot, reboots — fully automatic fleet updates" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg10" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg10r2" value="• Manual mode: own AP + upload page — recover any bricked zone with a phone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg10" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg10r3" value="• While a zone sits in rescue, its UART repeater keeps the ring closed for everyone downstream" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg10" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>