                <mxCell id="pdisplayg2c11" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pdisplayg2" vertex="1">
