                </mxCell>
                <mxCell id="pdisplayg2a12" value="19/20" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="4" y="294" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2b12" value="USB D−/D+ (flashing + console)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="68" y="294" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2c12" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="408" y="294" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2ft" value="All other S3 pins are free — plenty of headroom for future panel extras (buzzer, LEDs, rotary encoder…)." style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=4;fontSize=10;fontColor=#666666;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="4" y="314" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg3" value="Legend" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="760" width="490" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg3r0" value="• Colour = when it lands:  SP1 Foundation (blue) · SP2 Shelf control (green) · SP3 Ring link (orange) · SP4 Web UI (purple) · SP5 Global control (red) · SP6 Display node (teal) · SP7 Media/SD (mauve) · Hardware (yellow) · Grey = out of scope V1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg3" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg3r1" value="• Pin table: free* = strapping pin, usable with care. Source of truth: docs/superpowers/specs/2026-08-31-hillgrow-system-design.md + docs/pin-mapping.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg3" vertex="1">
                    <mxGeometry x="4" y="104" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4" value="Master link — a plain API client — SP6" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="490" height="238" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4r0" value="• Sends CLI text lines, parses the single OK/ERR reply + two-space continuations — the HillBT wrover_link pattern" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg4" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4r1" value="• Machine-mode session on the master (SET ECHO OFF); identical grammar to PuTTY, web and ring — nothing special server-side" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg4" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4r2" value="• Subscribes to the NOTIFY types it displays (SET NOTIFY … ON) — live updates without polling everything" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg4" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4r3" value="• Link loss → &quot;master offline&quot; banner + auto-reconnect (prologue re-runs); the master runs identically with the display absent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg4" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg4r4" value="• Cannot bypass anything: every button press is an API command through the same safety gate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg4" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg5" value="V1 UI — one screen — SP6" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="352" width="490" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg5r0" value="• Status icons: zones online/offline · active faults · ring state · reservoir level" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg5" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg5r1" value="• A few live values: room temp/RH, reservoir %, per-zone soil averages (from GET + NOTIFY)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg5" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg5r2" value="• A couple of touch buttons mapped to API commands (e.g. overall grow light, fleet SAFE stop)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg5" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg5r3" value="• LVGL 9 via esp_lvgl_port; layout kept data-driven so screens can be added without redesign" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg5" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg6" value="Later expansion (not V1)" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="574" width="490" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg6r0" value="• Per-zone detail screens, config editing, audio player control, alarm browser" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg6" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg6r1" value="• Always a thin client: only what the API already offers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg6" vertex="1">
                    <mxGeometry x="4" y="56" width="482" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="zone" name="Zone Controller">
        <mxGraphModel dx="914" dy="1129" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="HillGrow — Zone Controller: feature map" style="text;html=1;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="Review copy generated from the approved system spec (2026-08-31). All zones run one identical binary; every shelf is independently configured." style="text;html=1;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="48" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1" value="Hardware" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="490" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r0" value="• ESP32-DevKitC-V4 — fits a 4 MB WROOM · the zone app NEVER starts Wi-Fi (design rule; frees ADC2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r1" value="• UART0 (GPIO1/3, USB): console — CLI + logs, 115200 (full standalone operation)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r2" value="• UART2 ring: RX GPIO18 ← upstream · TX GPIO19 → downstream · store-and-forward" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="96" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r3" value="• PCA9685 @0x40 (I²C): ch 0–7 = 4 shelves × LED (WHITE + RED) @ ~1 kHz · ch 8–11 = vibrator PWM shelf 1–4 · ch 12–15 spare (future fan PWM) · OE on GPIO23 with pull-up — all PCA outputs hardware-dead through boot/crash/rescue" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="120" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r4" value="• PCF8575 @0x20 (I²C, active-low): P0–P3 pumps 1–4 · P4–P7 fans 1–4 · P8–P15 spare relays (8)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r5" value="• Soil: 8 × DFRobot SEN0193 → ADC1 GPIO 32/33/34/35/36/39 + ADC2 GPIO 25/26 · 100 kΩ pull-downs · mV with eFuse calibration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="216" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r6" value="• Loads: 24 V V24S LED bars via MOSFET drivers · 12 V peristaltic pumps, fans, vibrator via drivers — ESP32 never powers loads" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="256" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r7" value="• Rescue button GPIO15 · status LED GPIO2 (mode blink patterns)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="296" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg1r8" value="• Flash 4 MB: rescue 1280 K (factory) · app A/B 1280/1344 K · versioned NVS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pzoneg1" vertex="1">
                    <mxGeometry x="4" y="320" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2" value="Pin allocation — Zone" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="464" width="490" height="656" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2h0" value="GPIO" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="4" y="32" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2h1" value="Function" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="68" y="32" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2h2" value="Status" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="408" y="32" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2a0" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pzoneg2" vertex="1">
                    <mxGeometry x="4" y="54" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pzoneg2b0" value="BOOT strap / on-board button" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pzoneg2" vertex="1">
