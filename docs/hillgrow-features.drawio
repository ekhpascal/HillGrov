                <mxCell id="pmasterg2b20" value="microSD MISO (SPI2)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
