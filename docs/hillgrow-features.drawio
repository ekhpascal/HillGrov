                <mxCell id="pdisplayg2b11" value="Touch MISO (SPI3)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
