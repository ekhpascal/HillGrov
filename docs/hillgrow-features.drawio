    <diagram id="master" name="Master Controller">
        <mxGraphModel dx="914" dy="1129" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="HillGrow — Master Controller: feature map" style="text;html=1;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="Review copy from the approved spec incl. owner extensions 2026-09-01 (overall grow light, display node, SD + audio, reservoir pins). Colours = delivering sub-project." style="text;html=1;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="48" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1" value="Hardware" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="490" height="622" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r0" value="• ESP32-DevKitC-V4 — 8 MB flash (16 MB option), WROOM class (GPIO16/17 kept free so WROVER would also work)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r1" value="• UART0 (GPIO1/3, USB): console — CLI + logs, 115200" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r2" value="• UART2 ring: TX GPIO19 → Zone 1 · RX GPIO18 ← last zone · 3.3 V TTL twisted pair, 115200, 10 kΩ pull-up on RX" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="96" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r3" value="• Wi-Fi APSTA: AP 192.168.7.7 (phone/PC → web UI, WPA2) + STA → house Wi-Fi (NTP, future cloud)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r4" value="• I²C (GPIO21/22): DS3231 RTC @0x68 · STCC4 @0x64 room CO₂+T/RH (companion SHT4x @0x44 on module) · AHT20 @0x38 + BMP280 @0x76/77 workshop T/RH/P · SC16IS752 @0x4D UART bridge" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r5" value="• PCF8575 @0x20, active-low relays: DUKA TT125 fan · intake damper · exhaust→workshop · exhaust→outside · BLIND open+close (DC motor) · refill solenoid · OVERALL GROW LIGHT · HEATER (thermal cutout in series!) — 9 used, 7 spare" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="216" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r6" value="• Blackout blind end-stops: closed → GPIO35 · open → GPIO36 (input-only, ext. pull-ups)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="272" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r7" value="• RS-485 Modbus field bus (via SC16IS752 + transceiver): PAR sensor 400–700 nm · outdoor/remote T/RH transmitters · multi-drop, one twisted pair" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="312" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r8" value="• Reservoir level: strain gauge under the tank — HX711 DOUT GPIO34, SCK GPIO5 (high at reset = HX711 power-down) · no floats: filling is manually stopped at full" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="352" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r9" value="• Display link UART1: GPIO26 TX / GPIO25 RX ↔ ESP32-S3 touch panel (optional node, SP6), 115200" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="408" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r10" value="• Room presence sensor: PIR / mmWave digital OUT → GPIO39 (occupancy for audio/courtesy strategies, SP5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="448" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r11" value="• microSD on SPI2: SCK 14 · MOSI 13 · MISO 27 · CS 4 — media storage (SP7)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="488" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r12" value="• I²S → PCM5102A DAC: BCK 33 · WS 32 · DOUT 23 (DAC SCK → GND) — audio player (SP7)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="512" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r13" value="• Rescue button GPIO15 (to GND) · status LED GPIO2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="552" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg1r14" value="• Flash layout: rescue 1280 K (factory) · app A/B 2 × 2 MB · zone_fw staging 1.5 MB · LittleFS data ~1 MB (alarms + history)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg1" vertex="1">
                    <mxGeometry x="4" y="576" width="482" height="40" as="geometry"/>
