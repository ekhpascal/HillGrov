                <mxCell id="pmasterg2a21" value="32" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="474" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b21" value="I²S WS/LRCK" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="474" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c21" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="474" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2a22" value="33" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="494" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b22" value="I²S BCK" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="494" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c22" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="494" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2a23" value="34" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="514" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b23" value="Strain gauge — HX711 DOUT (or analog level in)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="514" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c23" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="514" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2a24" value="35" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="534" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b24" value="Blind end-stop CLOSED (input-only, ext. pull-up)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="534" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c24" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="534" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2a25" value="36" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="554" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b25" value="Blind end-stop OPEN (input-only, ext. pull-up)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="554" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c25" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="554" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2a26" value="39" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="574" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2b26" value="Room presence sensor (PIR/mmWave OUT)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="68" y="574" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2c26" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="408" y="574" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg2ft" value="Master GPIO is FULLY allocated — none free (GPIO0 = DS18B20 1-Wire outdoor probe, boot-strap compatible). Further master I/O grows on the buses: PCF8575 7 spare pins, more I²C devices, optional PCA9685." style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=4;fontSize=10;fontColor=#666666;" parent="pmasterg2" vertex="1">
                    <mxGeometry x="4" y="594" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg3" value="Legend" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1416" width="490" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg3r0" value="• Colour = when it lands:  SP1 Foundation (blue) · SP2 Shelf control (green) · SP3 Ring link (orange) · SP4 Web UI (purple) · SP5 Global control (red) · SP6 Display node (teal) · SP7 Media/SD (mauve) · Hardware (yellow) · Grey = out of scope V1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg3" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg3r1" value="• Pin table: free* = strapping pin, usable with care. Source of truth: docs/superpowers/specs/2026-08-31-hillgrow-system-design.md + docs/pin-mapping.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg3" vertex="1">
                    <mxGeometry x="4" y="104" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4" value="CLI on UART0 — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="490" height="302" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r0" value="• HillBT grammar: SET/GET · one OK/ERR reply line · trailing HELP on any prefix · NOTIFY pushes · generated help with ranges" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r1" value="• System: GET ID / VERSION / STATUS · SET LOG &lt;level&gt; [tag] · REBOOT CONFIRM · FACTORY RESET CONFIRM · SAVE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r2" value="• Node admin: GET NODES / NODE / UNASSIGNED · SET NODE n NAME/MAC · CLEAR NODE (assign, rename, replace boards)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r3" value="• Master relays: SET OUT n &lt;minutes&gt; — duration-bounded manual control (no unlock needed, web UI uses it too)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r4" value="• Network/time: SET WIFI STA|AP · SET NTP · SET TZ · GET/SET TIME" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r5" value="• DEBUG ENABLE &lt;key&gt; (Kconfig, default hill) gates raw pokes (GPIO/PCA/PCF/ADC), FW rollback" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="216" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg4r6" value="• ZONE n prefix: any zone command runs remotely, reply verbatim — master needs no zone vocabulary" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg4" vertex="1">
                    <mxGeometry x="4" y="256" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5" value="Config &amp; persistence — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="416" width="490" height="222" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5r0" value="• Zone table (MAC → id, auto-assigned) · per-zone logical configs zc1..8 · 16 crop profiles (Leafy/Fruiting/Seedling seeded, copy-on-apply + explicit REAPPLY)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg5" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5r1" value="• Master config: Wi-Fi credentials (single home, RAM-loaded), TZ, NTP host" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg5" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5r2" value="• Every stored blob wears a magic+version+CRC envelope; a dedicated store task is the only flash writer; write throttling against NVS wear" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg5" vertex="1">
                    <mxGeometry x="4" y="96" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5r3" value="• Master NVS loss self-heals: zones re-enrol and their cached configs are adopted back" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg5" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg5r4" value="• JSON export/import of the whole system (disaster-recovery backup, includes Wi-Fi creds; ?secrets=0 to omit)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg5" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg6" value="Rescue &amp; bootloader — SP1" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="662" width="490" height="158" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg6r0" value="• Custom bootloader: app-requested RTC flag → rescue once · GPIO15 ≥10 s → rescue · 1–9 s → NVS factory erase · rollback when a new image never proves itself" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg6" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg6r1" value="• Shared rescue image (same binary on master and zones): manual mode = AP HillGrow-Rescue-&lt;MAC&gt; @192.168.7.7 with one upload page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg6" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg6r2" value="• Master self-update: web upload straight into the inactive A/B slot; reboot; self-test or automatic rollback" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg6" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7" value="Display node (ESP32-S3 touch panel) — SP6" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="844" width="490" height="254" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7r0" value="• ESP32-S3-DevKitC-1 (N8R8) + 3.5″ ST7796S 480×320 SPI + XPT2046 touch — the proven HillBT-s3 hardware, reused nearly unchanged (LVGL 9)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg7" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7r1" value="• Talks to the master over plain UART as just another API client: sends CLI lines, consumes OK/ERR + NOTIFY — nothing bypasses the safety gate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg7" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7r2" value="• V1 UI: ONE screen — status icons (zones online, faults, ring, reservoir) + a few live values + a couple of touch buttons mapped to API commands; expands later" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg7" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7r3" value="• Deliberately simple — not a web-UI duplicate; only what the API offers (read values, flip outputs)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg7" vertex="1">
                    <mxGeometry x="4" y="168" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg7r4" value="• Own IDF project (esp32s3 target), USB flashing, no rescue/AB; master runs identically with the display absent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg7" vertex="1">
                    <mxGeometry x="4" y="208" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8" value="Media: SD card + audio — SP7" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#e6d0de;strokeColor=#996185;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="1122" width="490" height="222" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8r0" value="• microSD on SPI2 (FAT, hot-plug tolerant) — media storage only; alarms/history stay on internal LittleFS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg8" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8r1" value="• I²S → PCM5102A DAC (GY-PCM5102, SCK pin tied to GND)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg8" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8r2" value="• Audio player: stream WAV files from SD (MP3 via software decoder = stretch goal, SP7 feature spec decides)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg8" vertex="1">
                    <mxGeometry x="4" y="96" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8r3" value="• Controlled from CLI + web + display node: PLAY/STOP/NEXT, playlist folder, soft volume, NOTIFY on track change" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg8" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg8r4" value="• Player isolated (I²S DMA + own file-read task, ~24 KB buffers) — audio can never delay safety, ring or control work" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg8" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9" value="Web UI + HTTP API — SP4" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="90" width="490" height="326" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r0" value="• Dashboard: all zones and shelves live (1 Hz polling) — soil %, outputs, modes, faults, node health" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r1" value="• Configuration editing: zone naming/assignment, per-shelf crop + light/water/fan/pollination settings, profiles" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r2" value="• Alarms: active + history, acknowledge/clear" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r3" value="• History plots: 10-minute samples (3 days) + hourly aggregates (30 days), per shelf" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="136" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r4" value="• Export: hourly history as a plain-text file download" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r5" value="• Firmware page: upload master.bin (self-update) · upload zone.bin (staging) · Update-zones button with progress" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="200" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r6" value="• POST /api/cmd: every button sends a CLI line — one grammar, one safety path, copy-pasteable into PuTTY" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="240" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg9r7" value="• Served from the AP at 192.168.7.7 (works with zero internet); assets embedded gzipped in the app image" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg9" vertex="1">
                    <mxGeometry x="4" y="280" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg10" value="Alarms &amp; history store — SP4" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="440" width="490" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg10r0" value="• Alarm manager: every fault edge from every node → persistent log on LittleFS (2 × 64 KB rotating) + RAM ring for the UI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg10" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg10r1" value="• History writer: samples from heartbeats, day files, oldest-first retention sweep" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg10" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg10r2" value="• NOTIFY stream on the console mirrors alarms/events live" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg10" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11" value="Global climate &amp; water — SP5" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="606" width="490" height="454" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r0" value="• Ventilation strategy on dew point / absolute humidity (room + workshop T/RH · outdoor T; outdoor RH optional later via field bus) — not simple RH; chooses exhaust path workshop vs outside" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r1" value="• CO₂/T/RH (STCC4 Gravity), workshop T/RH/P (AHT20+BMP280), outdoor T (DS18B20 1-Wire GPIO0) and PAR (RS-485, 400–700 nm): dashboards, DLI cross-check, ventilation/lighting strategy inputs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="88" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r2" value="• Heater: setpoint + hysteresis, valid-temp interlock, high-limit latch, min-off 60 s — mechanical thermal cutout in series (hardware rule)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="128" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r3" value="• Damper interlocks: main fan only runs with intake + at least one exhaust open (re-checked every 100 ms); open/close never driven together; stuck detection" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="168" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r4" value="• Reservoir: strain-gauge level (tare/full calibration); refill valve manual + duration-bounded (operator stops at full) with max-run/daily caps; low level inhibits all pumps fleet-wide; stuck/implausible weight → fault" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="208" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r5" value="• OVERALL GROW LIGHT (relay): room-wide supplemental light — own on/off schedule, daily-hours budget, duration-bounded manual override, blackout coordination" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="264" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r6" value="• Blackout blind: DC motor + end-stops — position model, stop-at-end-stop, travel timeout → stuck fault, schedule + photoperiod coordination" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="304" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r7" value="• Fleet stop: SET SAFE ON → all zones dark within 2 s; self-releases if the master dies (zones keep growing)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="344" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r8" value="• Room presence (GPIO39): occupancy-hold state → telemetry/UI/display, NOTIFY ROOM ENTER/EMPTY, condition for audio/courtesy strategies — never a safety input" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="384" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg11r9" value="• (deferred: heater / dehumidifier)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg11" vertex="1">
                    <mxGeometry x="4" y="424" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg12" value="Time service — SP3/SP5" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1084" width="490" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg12r0" value="• DS3231 is the boot-time authority (no internet required, ever, for schedules)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg12" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg12r1" value="• NTP over the house Wi-Fi corrects the RTC when available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg12" vertex="1">
                    <mxGeometry x="4" y="56" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg12r2" value="• POSIX timezone → local-time offset (DST handled), distributed to all zones over the ring" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg12" vertex="1">
                    <mxGeometry x="4" y="80" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13" value="Ring master / node manager — SP3" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1234" width="490" height="318" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r0" value="• Discovery &amp; enrolment: new board heartbeats its MAC → auto-assigned lowest free id → appears in UI unconfigured" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r1" value="• Node health: ONLINE / DEGRADED (5 s) / OFFLINE (10 s) / FAULT / UPDATING, per node" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r2" value="• Ring-break blame: names the dead node or cable segment (e.g. &quot;Z2 dead or wire Z2→Z3&quot;)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r3" value="• TIME_SYNC broadcast every 2 s: wall clock + tz, who-is-online mask, fleet inhibit flags (pumps/lights/all)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r4" value="• Command forwarding: SET ZONE n … as CLI text, ACKed, exactly-once (safe for pump doses), reply passed back verbatim" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r5" value="• Config push with adopt-at-enrolment and revert-on-local-edit (Master always wins; NOTIFY CFG_REVERTED)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="232" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg13r6" value="• Telemetry collection from 2 s heartbeats: per-shelf soil/outputs/faults + comm counters per node" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg13" vertex="1">
                    <mxGeometry x="4" y="272" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg14" value="Fleet &amp; self OTA — SP3/SP4" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1576" width="490" height="214" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg14r0" value="• zone.bin staged in the zone_fw partition (validated: magic, project name, version)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg14" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg14r1" value="• Update zones: one at a time — ring command → zone enters safe state → reboots to rescue → rescue joins master AP and pulls /fw/zone.bin → flashes inactive slot → proves itself via heartbeat → next zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg14" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg14r2" value="• Rescue image on the updating zone repeats ring bytes so downstream zones stay online" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg14" vertex="1">
                    <mxGeometry x="4" y="128" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg14r3" value="• Failed node stops the sequence (no retry storms); alarms suppressed during the 180 s window" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg14" vertex="1">
                    <mxGeometry x="4" y="168" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15" value="Safety &amp; robustness — SP1/SP2" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1814" width="490" height="222" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15r0" value="• Task watchdog 8 s with panic, all app tasks subscribed, idle tasks watched · interrupt WDT · brown-out 2.80 V" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg15" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15r1" value="• Modes BOOT / TRIAL / HOLD / RUN / SAFE (LOCAL is zone-only) · crash-loop ladder: 3 abnormal resets → 300 s HOLD → latched SAFE (≤9 output pulses ever)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg15" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15r2" value="• PCF8575 read-back audit (1 s) · I²C recovery ladder → SAFE on persistent bus failure · shutdown handler forces relays off on every restart" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg15" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15r3" value="• OTA trial: fresh image must bring up AP + web server or it rolls back" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg15" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg15r4" value="• One safety gate for every output — web/cloud/CLI can never bypass local interlocks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg15" vertex="1">
                    <mxGeometry x="4" y="176" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg16" value="Out of scope V1 (explicit)" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="2060" width="490" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg16r0" value="• Cloud / remote access (architecture keeps the door open; never required for operation)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg16" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg16r1" value="• Dehumidifier control (actuator class later; heater is now in SP5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg16" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg16r2" value="• OTA of the rescue image (USB only) · ring-carried firmware bytes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg16" vertex="1">
                    <mxGeometry x="4" y="96" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pmasterg16r3" value="• RS-485 transceivers on the ring (escalation path if CRC error counters climb)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pmasterg16" vertex="1">
                    <mxGeometry x="4" y="120" width="482" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="display" name="Display Node (S3)">
        <mxGraphModel dx="914" dy="1129" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="HillGrow — Display node (ESP32-S3 touch panel): feature map" style="text;html=1;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="Owner extension 2026-09-01 (SP6). A thin API client on the master UART — hardware reused from HillBT s3." style="text;html=1;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="48" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1" value="Hardware" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="490" height="262" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r0" value="• ESP32-S3-DevKitC-1 (N8R8): 8 MB flash + 8 MB octal PSRAM — the proven HillBT-s3 platform, reused nearly unchanged" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="32" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r1" value="• 3.5″ ST7796S 480×320 on SPI2 @ 40/80 MHz: CLK 12 · MOSI 11 · CS 10 · DC 9 · RST 8 · backlight 7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="72" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r2" value="• XPT2046 resistive touch on its own SPI3 bus: CLK 41 · MOSI 40 · MISO 42 · CS 39 (polled with pressure threshold)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="112" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r3" value="• Master link UART1: TX 17 → master GPIO25 · RX 18 ← master GPIO26 · 115200 8N1 · common GND" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="152" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r4" value="• Built-in USB: flashing + console — single factory app (~7.9 MB slot), no rescue/AB on this node" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="192" width="482" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg1r5" value="• No Wi-Fi, no BT — the display talks to nothing but the master UART" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" parent="pdisplayg1" vertex="1">
                    <mxGeometry x="4" y="232" width="482" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2" value="Pin allocation — Display node (S3)" style="swimlane;rounded=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;horizontal=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="376" width="490" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2h0" value="GPIO" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="4" y="32" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2h1" value="Function" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="68" y="32" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2h2" value="Status" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fontStyle=1;fillColor=#eeeeee;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="408" y="32" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2a0" value="7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="4" y="54" width="64" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2b0" value="LCD backlight (PWM)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="68" y="54" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2c0" value="used" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;fillColor=#dae8fc;align=center;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="408" y="54" width="78" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pdisplayg2a1" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=4;strokeColor=#bbbbbb;" parent="pdisplayg2" vertex="1">
                    <mxGeometry x="4" y="74" width="64" height="20" as="geometry"/>
                </mxCell>
