# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v1 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

#Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# BT Configuration
CONFIG_BT_ENABLED=n
#CONFIG_BT_CONTROLLER_ONLY=y

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y

# SDIO datapath mode: STREAM, not the rel-3 default SW_AGGR.
#
# SW_AGGR needs an ESP-IDF carrying commit 4814514 (per-chip descriptor
# limits) to send more than 4092 B per SDIO transfer, and IDF 6.0.1 does not
# have it -- the CP build hard-fails with "this ESP-IDF lacks the send-cap
# fix" and points at `eh.py patch-idf`. We deliberately do NOT patch the
# shared IDF install: it sits outside version control and every other project
# on the machine (including HillGrow master/zone/rescue) builds against it.
#
# STREAM uses IDF's own hardware batching and needs no patch. It is also what
# already works here: the factory CP negotiates down to it and the host logs
# "SDIO Host operating in STREAMING MODE" at 1571 kB/s measured -- ample for a
# 246 KB zone image. Revisit only if throughput ever becomes the constraint.
CONFIG_EH_TRANSPORT_CP_SDIO_MODE_STREAM=y
